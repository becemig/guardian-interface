[gd_scene load_steps=4 format=3 uid="uid://research_wing_001"]

; -------------------------------------------------------------------------------
; ResearchWing.tscn - Guardian Interface - Trinity Protocol
; -------------------------------------------------------------------------------
; SCENE TREE:
;
; ResearchWing (Control, full-rect) - ResearchWing.cs
; --- RootLayout (VBoxContainer, full-rect)
;     --- TopBar (HBoxContainer, h=44)
;     -   --- WingTitle (Label)                 "REASONING WORKBENCH"
;     -   --- ModeSelector (HBoxContainer)
;     -   -   --- BtnTopDown (Button)            "TOP-DOWN"
;     -   -   --- BtnBottomUp (Button)           "BOTTOM-UP"
;     -   -   --- BtnModifier (Button)           "MODIFIER"
;     -   --- HSpacer
;     -   --- BridgeStatus (Label)               "[LIVE]" / "[OFFLINE]"
;     -   --- BtnSwitchMode (Button)             "<< EXIT RESEARCH"
;     -
;     --- FilterBar (HBoxContainer, h=36)
;     -   --- FilterLabel (Label)                "EVIDENCE:"
;     -   --- ChipEmpirical (Button, toggle)     "Empirical"
;     -   --- ChipPhenomenal (Button, toggle)    "Phenomenological"
;     -   --- ChipSymbolic (Button, toggle)      "Symbolic/Historical"
;     -   --- ChipSpeculative (Button, toggle)   "Speculative"
;     -   --- ChipOpenQ (Button, toggle)         "Open Question"
;     -   --- HSpacer
;     -   --- ChkSelfSafe (CheckButton)          "Self-Safe Only"
;     -   --- SearchBox (LineEdit)               placeholder "Search..."
;     -
;     --- RedFlagBanner (PanelContainer, hidden by default)
;     -   --- RedFlagLabel (RichTextLabel)
;     -
;     --- MainSplit (HSplitContainer, expand)
;     -   --- LeftPane (VBoxContainer, min_w=320)
;     -   -   --- TaxonomyTabs (TabContainer)
;     -   -   -   --- [Tab: PATTERNS]
;     -   -   -   -   --- PatternTree (Tree)
;     -   -   -   --- [Tab: ACUPOINTS]
;     -   -   -   -   --- AcupointList (ItemList)
;     -   -   -   --- [Tab: HERBS]
;     -   -   -   -   --- HerbList (ItemList)
;     -   -   -   --- [Tab: SYMPTOMS]
;     -   -   -   -   --- SymptomList (ItemList)
;     -   -   -   --- [Tab: FORMULAS]
;     -   -   -       --- FormulaList (ItemList)
;     -   -   --- TelemetryStatus (Label)        "VOL-xxx | Node: ..."
;     -   -
;     -   --- RightPane (VBoxContainer, expand)
;     -       --- DetailTabs (TabContainer)
;     -       -   --- [Tab: DETAIL]
;     -       -   -   --- DetailScroll (ScrollContainer)
;     -       -   -       --- DetailPanel (VBoxContainer)
;     -       -   -           --- DetailTitle (RichTextLabel)
;     -       -   -           --- EvidenceBadge (Label)
;     -       -   -           --- DetailBody (RichTextLabel)
;     -       -   -           --- RelatedItems (VBoxContainer)
;     -       -   --- [Tab: ATLAS VOLUME]
;     -       -   -   --- VolumePanel (VBoxContainer)
;     -       -   -       --- VolHeader (RichTextLabel)
;     -       -   -       --- SpectrumTabs (TabContainer)
;     -       -   -       -   --- [Physical] [Cognitive] [Metaphysical]
;     -       -   -       -   --- [Clinical] [Computational] [Temporal]
;     -       -   -       --- ModelAB (RichTextLabel)
;     -       -   --- [Tab: RED FLAGS]
;     -       -       --- RedFlagScroll (ScrollContainer)
;     -       -           --- RedFlagList (VBoxContainer)
;     -       --- ContextBar (HBoxContainer, h=32)
;     -           --- ContextPath (Label)        "Pattern > Acupoint > ..."
;     -           --- BtnClearContext (Button)   "CLEAR"
;     -
;     --- StatusBar (HBoxContainer, h=28)
;         --- StatusLeft (Label)                 mode + filter summary
;         --- StatusRight (Label)                "Perplexity Computer - Guardian Interface"
;
; -------------------------------------------------------------------------------

[ext_resource type="Script" path="res://scripts/wings/ResearchWing.cs" id="1"]

[node name="ResearchWing" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="RootLayout" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 0

; -- TOP BAR --------------------------------------------------------------------
[node name="TopBar" type="PanelContainer" parent="RootLayout"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2

[node name="TopBarInner" type="HBoxContainer" parent="TopBar"]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 12

[node name="SpineBar" type="ColorRect" parent="TopBar"]
custom_minimum_size = Vector2(3, 0)
color = Color(0.788, 0.588, 0.165, 1.0)

[node name="WingTitle" type="Label" parent="TopBar/TopBarInner"]
text = "REASONING WORKBENCH"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.788, 0.588, 0.165, 1.0)
vertical_alignment = 1

[node name="ModeSeparator" type="VSeparator" parent="TopBar/TopBarInner"]

[node name="ModeSelector" type="HBoxContainer" parent="TopBar/TopBarInner"]
theme_override_constants/separation = 4

[node name="BtnTopDown" type="Button" parent="TopBar/TopBarInner/ModeSelector"]
text = "TOP-DOWN"
toggle_mode = true
button_pressed = true
theme_override_font_sizes/font_size = 11

[node name="BtnBottomUp" type="Button" parent="TopBar/TopBarInner/ModeSelector"]
text = "BOTTOM-UP"
toggle_mode = true
theme_override_font_sizes/font_size = 11

[node name="BtnModifier" type="Button" parent="TopBar/TopBarInner/ModeSelector"]
text = "MODIFIER"
toggle_mode = true
theme_override_font_sizes/font_size = 11

[node name="HSpacer" type="Control" parent="TopBar/TopBarInner"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BridgeStatus" type="Label" parent="TopBar/TopBarInner"]
text = "[OFFLINE]"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.478, 0.471, 0.455, 1.0)

[node name="BtnSwitchMode" type="Button" parent="TopBar/TopBarInner"]
text = "<< EXIT"
theme_override_font_sizes/font_size = 11

; -- FILTER BAR -----------------------------------------------------------------
[node name="FilterBar" type="PanelContainer" parent="RootLayout"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2

[node name="FilterBarInner" type="HBoxContainer" parent="FilterBar"]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 6

[node name="FilterLabel" type="Label" parent="FilterBar/FilterBarInner"]
text = "EVIDENCE:"
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.478, 0.471, 0.455, 1.0)
vertical_alignment = 1

[node name="ChipEmpirical" type="Button" parent="FilterBar/FilterBarInner"]
text = "Empirical"
toggle_mode = true
button_pressed = true
theme_override_font_sizes/font_size = 10

[node name="ChipPhenomenal" type="Button" parent="FilterBar/FilterBarInner"]
text = "Phenomenological"
toggle_mode = true
button_pressed = true
theme_override_font_sizes/font_size = 10

[node name="ChipSymbolic" type="Button" parent="FilterBar/FilterBarInner"]
text = "Symbolic / Historical"
toggle_mode = true
button_pressed = true
theme_override_font_sizes/font_size = 10

[node name="ChipSpeculative" type="Button" parent="FilterBar/FilterBarInner"]
text = "Speculative"
toggle_mode = true
button_pressed = true
theme_override_font_sizes/font_size = 10

[node name="ChipOpenQ" type="Button" parent="FilterBar/FilterBarInner"]
text = "Open Question"
toggle_mode = true
button_pressed = true
theme_override_font_sizes/font_size = 10

[node name="FilterSpacer" type="Control" parent="FilterBar/FilterBarInner"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ChkSelfSafe" type="CheckButton" parent="FilterBar/FilterBarInner"]
text = "Self-Safe Only"
theme_override_font_sizes/font_size = 10

[node name="SearchBox" type="LineEdit" parent="FilterBar/FilterBarInner"]
placeholder_text = "Search..."
custom_minimum_size = Vector2(180, 0)
theme_override_font_sizes/font_size = 11

; -- RED FLAG BANNER (hidden until triggered) ------------------------------------
[node name="RedFlagBanner" type="PanelContainer" parent="RootLayout"]
visible = false
layout_mode = 2

[node name="RedFlagLabel" type="RichTextLabel" parent="RedFlagBanner"]
bbcode_enabled = true
text = "[color=#C92A2A][b]RED FLAG:[/b][/color] Refer to a qualified clinician. Do not attempt self-care."
custom_minimum_size = Vector2(0, 32)
fit_content = true

; -- MAIN SPLIT -----------------------------------------------------------------
[node name="MainSplit" type="HSplitContainer" parent="RootLayout"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 340
dragger_visibility = 1

; -- LEFT PANE - Taxonomy browser -----------------------------------------------
[node name="LeftPane" type="VBoxContainer" parent="MainSplit"]
