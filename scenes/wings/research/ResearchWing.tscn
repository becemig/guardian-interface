[node name="HERBS" type="VBoxContainer" parent="MainSplit/LeftPane/TaxonomyTabs"]
layout_mode = 2

[node name="HerbList" type="ItemList" parent="MainSplit/LeftPane/TaxonomyTabs/HERBS"]
