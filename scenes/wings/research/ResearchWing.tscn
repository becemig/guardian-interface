[node name="FORMULAS" type="VBoxContainer" parent="MainSplit/LeftPane/TaxonomyTabs"]
layout_mode = 2

[node name="FormulaList" type="ItemList" parent="MainSplit/LeftPane/TaxonomyTabs/FORMULAS"]
