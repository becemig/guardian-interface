[node name="SYMPTOMS" type="VBoxContainer" parent="MainSplit/LeftPane/TaxonomyTabs"]
layout_mode = 2

[node name="SymptomList" type="ItemList" parent="MainSplit/LeftPane/TaxonomyTabs/SYMPTOMS"]
layout_mode = 2
