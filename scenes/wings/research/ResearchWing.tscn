layout_mode = 2

[node name="PatternTree" type="Tree" parent="MainSplit/LeftPane/TaxonomyTabs/PATTERNS"]
layout_mode = 2
size_flags_vertical = 3
hide_root = true
select_mode = 1
allow_reselect = true

[node name="ACUPOINTS" type="VBoxContainer" parent="MainSplit/LeftPane/TaxonomyTabs"]
layout_mode = 2

[node name="AcupointList" type="ItemList" parent="MainSplit/LeftPane/TaxonomyTabs/ACUPOINTS"]
layout_mode = 2
size_flags_vertical = 3
